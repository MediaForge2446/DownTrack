<Window x:Class="DownTrack.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DownTrack"
        Width="1440" Height="900"
        MinWidth="640" MinHeight="480"
        WindowState="Maximized"
        WindowStyle="None" ResizeMode="CanResize" AllowsTransparency="True"
        Background="Transparent" SnapsToDevicePixels="True"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            CornerRadius="18" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <Viewbox Stretch="Uniform"
                     StretchDirection="Both"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     MaxWidth="2200"
                     MaxHeight="1350">
                <Grid Width="1440" Height="900">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Background="{StaticResource SurfaceBrush}"
                          MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="22,0,0,0">
                            <Border Width="34" Height="34" CornerRadius="10"
                                    Background="{StaticResource AccentSoftGradientBrush}">
                                <Grid>
                                    <Ellipse Width="20" Height="20"
                                             Stroke="{StaticResource AccentBrush}"
                                             StrokeThickness="3"/>
                                    <Rectangle Width="5" Height="15"
                                               RadiusX="2.5" RadiusY="2.5"
                                               Fill="{StaticResource TealBrush}"
                                               Margin="5,-2,0,0"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="DownTrack" Margin="11,0,0,0"
                                       FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="  /  "
                                       Foreground="{StaticResource MutedTextBrush}"
                                       Margin="4,0,0,0"/>
                            <TextBlock Text="{Binding CurrentFolderLabel}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="520"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    Margin="0,0,10,0">
                            <Button Content="&#xE921;"
                                    FontFamily="Segoe Fluent Icons"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Minimize"
                                    Click="Minimize_Click"/>
                            <Button Content="&#xE922;"
                                    FontFamily="Segoe Fluent Icons"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Maximize / restore"
                                    Click="Maximize_Click"/>
                            <Button Content="&#xE8BB;"
                                    FontFamily="Segoe Fluent Icons"
                                    Style="{StaticResource IconButton}"
                                    ToolTip="Close"
                                    Click="Close_Click"
                                    Margin="2,0,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1"
                            Background="{StaticResource WindowBrush}"
                            CornerRadius="0,0,18,18">
                        <ContentControl Content="{Binding CurrentViewModel}"/>
                    </Border>
                </Grid>
            </Viewbox>
        </Grid>
    </Border>
</Window>