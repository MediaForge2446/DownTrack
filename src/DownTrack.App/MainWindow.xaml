<Window x:Class="DownTrack.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DownTrack.Infrastructure.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="DownTrack"
        Width="1440"
        Height="900"
        MinWidth="980"
        MinHeight="620"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationService.Instance}}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="18"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="74"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- App toolbar -->
            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddMediaCommand}"
                            IsEnabled="{Binding IsExplorer}"
                            MinWidth="132"
                            Height="42"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontSize="15" Margin="0,0,7,0"/>
                            <TextBlock Text="{loc:Loc Key=Shell.AddMedia}"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding AddRootFolderCommand}"
                            MinWidth="132"
                            Height="42">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="＋" FontSize="15" Margin="0,0,7,0"/>
                            <TextBlock Text="{loc:Loc Key=Shell.AddFolder}"/>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="2"
                            HorizontalAlignment="Center"
                            MinWidth="320"
                            MaxWidth="620"
                            Height="42"
                            Padding="15,0"
                            Background="{StaticResource SurfaceSoftBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <TextBlock Text="{Binding LocationPath}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding GoHomeCommand}"
                                Click="HomeShell_Click"
                                Content="⌂"
                                ToolTip="{loc:Loc Key=Shell.Home}"/>
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding ForwardCommand}"
                                Content="→"
                                Margin="4,0,0,0"
                                ToolTip="{loc:Loc Key=Shell.Forward}"/>
                        <Button Style="{StaticResource IconButton}"
                                Command="{Binding BackCommand}"
                                Content="←"
                                Margin="4,0,0,0"
                                ToolTip="{loc:Loc Key=Shell.Back}"/>
                        <Border Margin="12,0,10,0"
                                Padding="10,5"
                                CornerRadius="10"
                                Background="{StaticResource CyanSoftBrush}">
                            <TextBlock Text="{Binding EngineLabel}"
                                       Foreground="{StaticResource CyanBrush}"
                                       FontSize="10"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="DownTrack"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>

                        <Button Content="—"
                                Style="{StaticResource IconButton}"
                                ToolTip="{loc:Loc Key=Window.Minimize}"
                                Click="Minimize_Click"/>
                        <Button Content="□"
                                Style="{StaticResource IconButton}"
                                ToolTip="{loc:Loc Key=Window.Maximize}"
                                Click="Maximize_Click"/>
                        <Button Content="×"
                                Style="{StaticResource IconButton}"
                                ToolTip="{loc:Loc Key=Window.Close}"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Workspace -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="236"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Root folders sidebar -->
                <Border Grid.Column="0"
                        Background="{StaticResource SurfaceSoftBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">
                    <Grid Margin="18,22,18,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="DownTrack"
                                       FontSize="20"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Key=Shell.Library}"
                                       Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>

                        <Button Grid.Row="1"
                                Command="{Binding GoHomeCommand}"
                                Margin="0,22,0,10"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource SecondaryButton}"
                                Height="42">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌂" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="{loc:Loc Key=Shell.Home}"/>
                            </StackPanel>
                        </Button>

                        <Button Grid.Row="2"
                                Command="{Binding AddRootFolderCommand}"
                                HorizontalContentAlignment="Left"
                                Style="{StaticResource GhostButton}"
                                Height="38"
                                Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="＋" FontSize="14" Margin="0,0,8,0"/>
                                <TextBlock Text="{loc:Loc Key=Library.AddRootFolder}"/>
                            </StackPanel>
                        </Button>

                        <ListBox Grid.Row="3"
                                 x:Name="RootList"
                                 ItemsSource="{Binding RootFolders}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 SelectionChanged="RootList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,3"
                                            Padding="11,10"
                                            CornerRadius="11">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="30"
                                                    Height="30"
                                                    CornerRadius="9"
                                                    Background="{StaticResource SoftGradientBrush}">
                                                <TextBlock Text="▣"
                                                           FontSize="13"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        Margin="9,0,0,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Path}"
                                                           Margin="0,2,0,0"
                                                           FontSize="8"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Button Grid.Row="4"
                                Style="{StaticResource GhostButton}"
                                HorizontalContentAlignment="Left"
                                Height="42"
                                Click="Settings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙" FontSize="15" Margin="0,0,10,0"/>
                                <TextBlock Text="{loc:Loc Key=App.Settings}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="{StaticResource WindowBrush}">
                    <ContentControl Content="{Binding CurrentViewModel}"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>