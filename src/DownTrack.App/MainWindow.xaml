<Window x:Class="DownTrack.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:DownTrack.Infrastructure.Localization"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationService.Instance}}"
        Title="DownTrack"
        Width="1440"
        Height="900"
        MinWidth="1040"
        MinHeight="640"
        WindowState="Normal"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Background="{DynamicResource WindowBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="78"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddMediaCommand}"
                            MinWidth="132"
                            Height="44">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Key=Shell.AddMedia}"/>
                            <TextBlock Text="＋"
                                       Margin="7,0,0,0"
                                       FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Command="{Binding NewFolderCommand}"
                            Margin="10,0,0,0"
                            MinWidth="138"
                            Height="44">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc Key=Shell.AddFolder}"/>
                            <TextBlock Text="⊞"
                                       Margin="7,0,0,0"
                                       FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="3"
                            Height="44"
                            Margin="0,0,18,0"
                            Background="{DynamicResource SurfaceSoftBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <TextBlock Text="{Binding BreadcrumbText}"
                                       Margin="16,0,52,0"
                                       VerticalAlignment="Center"
                                       FontSize="13"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="⌕"
                                       Margin="0,0,15,0"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="20"
                                       Foreground="{DynamicResource MutedTextBrush}"/>
                        </Grid>
                    </Border>

                    <Button Grid.Column="4"
                            Style="{StaticResource IconButton}"
                            Command="{Binding HomeCommand}"
                            ToolTip="{loc:Loc Key=Shell.Home}">
                        <TextBlock Text="⌂"
                                   FontSize="18"/>
                    </Button>
                    <Button Grid.Column="5"
                            Style="{StaticResource IconButton}"
                            Command="{Binding ForwardCommand}"
                            ToolTip="{loc:Loc Key=Shell.Forward}">
                        <TextBlock Text="→"
                                   FontSize="18"/>
                    </Button>
                    <Button Grid.Column="6"
                            Style="{StaticResource IconButton}"
                            Command="{Binding BackCommand}"
                            ToolTip="{loc:Loc Key=Shell.Back}">
                        <TextBlock Text="←"
                                   FontSize="18"/>
                    </Button>

                    <StackPanel Grid.Column="8"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="16,0,0,0">
                        <Border Width="42"
                                Height="42"
                                CornerRadius="13"
                                Background="{DynamicResource PrimaryGradientBrush}">
                            <Grid>
                                <Ellipse Width="24"
                                         Height="24"
                                         Stroke="White"
                                         StrokeThickness="2.4"
                                         Opacity="0.96"/>
                                <Border Width="7"
                                        Height="18"
                                        CornerRadius="4"
                                        Background="White"
                                        Opacity="0.92"/>
                            </Grid>
                        </Border>
                        <StackPanel Margin="11,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="DownTrack"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentFolderLabel}"
                                       Margin="0,2,0,0"
                                       FontSize="10"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="9"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                        <Button Content="—"
                                Style="{StaticResource IconButton}"
                                ToolTip="{loc:Loc Key=Window.Minimize}"
                                Click="Minimize_Click"/>
                        <Button Content="□"
                                Style="{StaticResource IconButton}"
                                ToolTip="{loc:Loc Key=Window.Maximize}"
                                Click="Maximize_Click"/>
                        <Button Content="×"
                                Style="{StaticResource IconButton}"
                                ToolTip="{loc:Loc Key=Window.Close}"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0"
                        Padding="16,22,14,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{loc:Loc Key=Shell.Library}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}"/>

                        <Button Grid.Row="1"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding HomeCommand}"
                                Margin="0,14,0,16"
                                HorizontalContentAlignment="Stretch"
                                Height="48">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⌂"
                                           FontSize="17"
                                           Width="28"/>
                                <TextBlock Text="{loc:Loc Key=Shell.Home}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid>
                                <TextBlock Text="{loc:Loc Key=Shell.RootFolders}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                                <Button HorizontalAlignment="Right"
                                        Style="{StaticResource IconButton}"
                                        Width="30"
                                        Height="30"
                                        Command="{Binding AddRootFolderCommand}"
                                        ToolTip="{loc:Loc Key=Home.AddRootFolder}">
                                    <TextBlock Text="＋"
                                               FontSize="15"/>
                                </Button>
                            </Grid>

                            <Button Grid.Row="1"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding AddRootFolderCommand}"
                                    Margin="0,10,0,10"
                                    Height="40"
                                    HorizontalContentAlignment="Stretch">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="＋"
                                               FontSize="14"
                                               Width="26"/>
                                    <TextBlock Text="{loc:Loc Key=Home.AddRootFolder}"
                                               FontSize="11"/>
                                </StackPanel>
                            </Button>

                            <ListBox Grid.Row="2"
                                     x:Name="RootList"
                                     ItemsSource="{Binding Home.Roots}"
                                     SelectedItem="{Binding CurrentRoot, Mode=TwoWay}"
                                     SelectionChanged="RootList_SelectionChanged"
                                     Margin="0,4,0,0"
                                     VerticalAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="9,9"
                                                Margin="0,2"
                                                CornerRadius="10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="30"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Width="28"
                                                        Height="28"
                                                        CornerRadius="8"
                                                        Background="{DynamicResource AccentSoftBrush}">
                                                    <TextBlock Text="□"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentBlueBrush}"/>
                                                </Border>

                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Name}"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>

                        <Button Grid.Row="3"
                                Style="{StaticResource GhostButton}"
                                Height="44"
                                HorizontalContentAlignment="Stretch"
                                Click="Settings_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚙"
                                           FontSize="16"
                                           Width="28"/>
                                <TextBlock Text="{loc:Loc Key=App.Settings}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Grid.Column="1"
                        Background="{DynamicResource WindowBrush}">
                    <ContentControl Content="{Binding CurrentViewModel}"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>