<Window x:Class="DownTrack.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:DownTrack.Infrastructure.Localization"
        Title="DownTrack"
        Width="1320"
        Height="820"
        MinWidth="760"
        MinHeight="520"
        WindowState="Normal"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Loaded="Window_Loaded">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="20"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="72"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Border Width="42"
                                Height="42"
                                CornerRadius="13"
                                Background="{StaticResource PrimaryGradientBrush}">
                            <Grid>
                                <Ellipse Width="23"
                                         Height="23"
                                         Stroke="White"
                                         StrokeThickness="2.5"
                                         Opacity="0.95"/>
                                <Border Width="7"
                                        Height="18"
                                        CornerRadius="4"
                                        Background="White"
                                        Opacity="0.9"/>
                            </Grid>
                        </Border>

                        <StackPanel Margin="13,0,0,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="DownTrack"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CurrentFolderLabel}"
                                       Margin="0,2,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Margin="18,0,0,0"
                                Padding="10,5"
                                CornerRadius="10"
                                Background="{StaticResource CyanSoftBrush}"
                                BorderBrush="#B9E4DE"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7"
                                         Height="7"
                                         Fill="{StaticResource SuccessBrush}"
                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[App.MediaEngine]}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource CyanBrush}"/>
                            </StackPanel>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Home.ToolReady}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <Border Margin="18,0,0,0"
                                Padding="10,5"
                                CornerRadius="10"
                                Background="{StaticResource AccentSoftBrush}"
                                BorderBrush="#D8CBEF"
                                BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Home.ToolReady}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[App.SetupRequired]}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBlueBrush}"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Content="⚙"
                                Style="{StaticResource IconButton}"
                                FontFamily="Segoe UI Symbol"
                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[App.Settings]}"
                                Click="Settings_Click"
                                Margin="0,0,5,0"/>
                        <Button Content="—"
                                Style="{StaticResource IconButton}"
                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[App.Minimize]}"
                                Click="Minimize_Click"/>
                        <Button Content="□"
                                Style="{StaticResource IconButton}"
                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[App.Maximize]}"
                                Click="Maximize_Click"/>
                        <Button Content="×"
                                Style="{StaticResource IconButton}"
                                Margin="3,0,0,0"
                                ToolTip="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[App.Close]}"
                                Click="Close_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Background="{StaticResource WindowBrush}"
                    CornerRadius="0,0,20,20">
                <ContentControl Content="{Binding CurrentViewModel}"/>
            </Border>
        </Grid>
    </Border>
</Window>