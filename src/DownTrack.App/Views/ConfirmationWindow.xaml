<Window x:Class="DownTrack.Views.ConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Width="500" Height="230" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">
    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="18" Padding="26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="MessageText" Grid.Row="1" Margin="0,10,0,0"
                       Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="Cancel_Click"/>
                <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="8,0,0,0" Click="Delete_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
