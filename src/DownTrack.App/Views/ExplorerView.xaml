<UserControl x:Class="DownTrack.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DownTrack.Infrastructure.Localization"
             FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationService.Instance}}"
             Background="Transparent">
    <Grid Margin="30,26,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="{loc:Loc Key=Explorer.Overline}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBlueBrush}"/>
                <TextBlock Text="{Binding RootName}"
                           Margin="0,6,0,0"
                           FontSize="27"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CurrentPath}"
                           Margin="0,5,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Padding="11,8"
                    CornerRadius="11"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{DynamicResource SuccessBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding PendingCountText}"
                               Margin="7,0,0,0"
                               FontSize="10"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Effect="{DynamicResource SoftShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="15,0"
                      VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="56"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="#"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="{loc:Loc Key=Explorer.Name}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Grid.Column="2"
                               Text="{loc:Loc Key=Explorer.Type}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Grid.Column="3"
                               Text="{loc:Loc Key=Explorer.State}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </Grid>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          MouseDoubleClick="Entry_DoubleClick">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Row"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,1,0,0"
                                                Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="15,11"><Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Width="38"
                                        Height="38"
                                        CornerRadius="11"
                                        Background="{DynamicResource SoftGradientBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding IsDirectory, Converter={StaticResource EntryIconConverter}}"
                                               FontSize="17"
                                               Foreground="{DynamicResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Margin="12,0,12,0"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FullPath}"
                                               Margin="0,3,0,0"
                                               FontSize="9"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Kind}"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center"/>

                                <TextBlock Grid.Column="3"
                                           Text="{Binding StateText}"
                                           FontSize="11"
                                           Foreground="{Binding State, Converter={StaticResource EntryStateBrushConverter}}"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="4"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <Button Style="{StaticResource GhostButton}"
                                            Command="{Binding DataContext.RenameCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            Width="72"
                                            Height="34">
                                        <TextBlock Text="{loc:Loc Key=Shell.Rename}"
                                                   FontSize="10"/>
                                    </Button>
                                    <Button Style="{StaticResource DangerButton}"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                            Margin="6,0,0,0"
                                            Width="68"
                                            Height="34">
                                        <TextBlock Text="{loc:Loc Key=Shell.Delete}"
                                                   FontSize="10"/>
                                    </Button>
                                </StackPanel>
                            </Grid></Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="60"
                            Height="60"
                            CornerRadius="17"
                            Background="{DynamicResource SoftGradientBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="＋"
                                   FontSize="27"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="{loc:Loc Key=Explorer.EmptyTitle}"
                               Margin="0,14,0,0"
                               FontSize="16"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:Loc Key=Explorer.EmptySubtitle}"
                               Margin="0,6,0,0"
                               FontSize="11"
                               Foreground="{DynamicResource MutedTextBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="17"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="17"
                Effect="{DynamicResource SoftShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Pending.Title}"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Loc Key=Pending.Subtitle}"
                                   Margin="0,3,0,0"
                                   FontSize="10"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Right"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding SaveChangesCommand}"
                            MinWidth="148">
                        <TextBlock Text="{Binding SaveButtonText}"
                                   FontSize="11"/>
                    </Button>
                </Grid>

                <StackPanel Grid.Row="1"
                            Margin="0,13,0,0">
                    <TextBlock Text="{Binding TotalProgress, StringFormat={}{0:0}%}"
                               HorizontalAlignment="Right"
                               FontSize="10"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                    <ProgressBar Height="6"
                                 Margin="0,5,0,0"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding TotalProgress}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="2"
                              MaxHeight="230"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,14,0,0">
                    <ItemsControl ItemsSource="{Binding PendingItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="10"
                                        Background="{DynamicResource SurfaceSoftBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="11">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,70,0"/>
                                            <TextBlock Text="{Binding ProgressText}"
                                                       HorizontalAlignment="Right"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource MutedTextBrush}"/>
                                        </Grid>
                                        <Grid Grid.Row="1"
                                              Margin="0,7,0,0">
                                            <ProgressBar Height="5"
                                                         Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding Progress}"/>
                                            <TextBlock Text="{Binding StatusText}"
                                                       Margin="0,10,38,0"
                                                       FontSize="9"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Button Content="×"
                                                    Style="{StaticResource IconButton}"
                                                    HorizontalAlignment="Right"
                                                    Width="28"
                                                    Height="28"
                                                    Margin="0,-4,0,0"
                                                    Tag="{Binding Change}"
                                                    Click="CancelPending_Click"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="3"
                           Text="{Binding StatusMessage}"
                           Margin="0,9,0,0"
                           FontSize="10"
                           Foreground="{DynamicResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>