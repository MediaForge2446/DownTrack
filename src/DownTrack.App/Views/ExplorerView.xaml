<UserControl x:Class="DownTrack.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="168"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding BackCommand}"
                        Content="&#xE72B;"
                        ToolTip="Back"/>
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding ForwardCommand}"
                        Content="&#xE72A;"
                        Margin="3,0,0,0"
                        ToolTip="Forward"/>
                <Button Style="{StaticResource GhostButton}"
                        Command="{Binding HomeCommand}"
                        Content="Home"
                        Margin="10,0,0,0"
                        MinWidth="68"/>
            </StackPanel>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    MaxWidth="720"
                    Width="560"
                    MinWidth="220"
                    Height="36"
                    Padding="11,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <TextBlock Text="{Binding CurrentPath}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}"
                        Command="{Binding NewFolderCommand}"
                        Content="＋  New Folder"/>
                <Button Style="{StaticResource GhostButton}"
                        Command="{Binding RenameCommand}"
                        Content="Rename"
                        Margin="7,0,0,0"/>
                <Button Style="{StaticResource DangerButton}"
                        Command="{Binding DeleteCommand}"
                        Content="Delete"
                        Margin="7,0,0,0"/>
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddMediaCommand}"
                        Margin="12,0,0,0"
                        MinWidth="128">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE1F7;" FontFamily="Segoe Fluent Icons"/>
                        <TextBlock Text="  Add Media"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Text="{Binding RootName}"
                       HorizontalAlignment="Right"
                       VerticalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}"
                       TextTrimming="CharacterEllipsis"
                       MaxWidth="260"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" MinWidth="170"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="10"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="FOLDERS"
                               Margin="4,2,4,0"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedTextBrush}"/>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Folders}"
                             Margin="0,9,0,0"
                             MouseDoubleClick="Folder_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,9"
                                        Margin="0,1"
                                        CornerRadius="9">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text=""
                                                   FontFamily="Segoe Fluent Icons"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="9,0,0,0"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Padding="12"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <ListView ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                          MouseDoubleClick="Entry_DoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="500" Header="NAME">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34"
                                                    Height="34"
                                                    CornerRadius="9"
                                                    Background="{StaticResource SurfaceElevatedBrush}">
                                                <TextBlock Text="{Binding IsDirectory, Converter={StaticResource EntryIconConverter}}"
                                                           FontFamily="Segoe Fluent Icons"
                                                           HorizontalAlignment="Center"
                                                           Foreground="{Binding State, Converter={StaticResource EntryStateBrushConverter}}"/>
                                            </Border>
                                            <StackPanel Margin="10,0,0,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="13"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FullPath}"
                                                           FontSize="10"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="86" Header="TYPE"
                                            DisplayMemberBinding="{Binding Kind}"/>
                            <GridViewColumn Width="92" Header="STATE">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StateText}"
                                                   FontSize="11"
                                                   Foreground="{Binding State, Converter={StaticResource EntryStateBrushConverter}}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>

        <Border Grid.Row="3"
                Margin="0,12,0,0"
                Padding="14"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Fill="{StaticResource PendingBrush}"
                                 VerticalAlignment="Center"/>
                        <TextBlock Text="  Pending Changes"
                                   FontSize="14"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="Not written to disk yet"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </Grid>

                <ScrollViewer Grid.Row="1"
                              Margin="0,9,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding PendingChanges}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8"
                                             Height="8"
                                             VerticalAlignment="Center"
                                             Fill="{Binding Status, Converter={StaticResource PendingStatusBrushConverter}}"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding ErrorMessage}"
                                                   Foreground="{StaticResource ErrorBrush}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Cancel"
                                            Style="{StaticResource GhostButton}"
                                            Padding="10,5"
                                            Click="CancelPending_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="2,9,2,0">
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       TextTrimming="CharacterEllipsis"/>
            <Button HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveChangesCommand}"
                    Content="{Binding SaveButtonText}"
                    MinWidth="166"/>
        </Grid>
    </Grid>
</UserControl>