<UserControl x:Class="DownTrack.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DownTrack.Infrastructure.Localization"
             FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationService.Instance}}"
             Background="Transparent">
    <Grid Margin="36,30,36,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="{loc:Loc Key=Explorer.Overline}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="{Binding RootName}"
                           Margin="0,6,0,0"
                           FontSize="29"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding CurrentPath}"
                           Margin="0,4,0,0"
                           FontSize="10"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <StackPanel HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding HomeCommand}"
                        Content="⌂"
                        ToolTip="{loc:Loc Key=Shell.Home}"/>
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding BackCommand}"
                        Content="←"
                        Margin="4,0,0,0"
                        ToolTip="{loc:Loc Key=Shell.Back}"/>
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding ForwardCommand}"
                        Content="→"
                        Margin="4,0,0,0"
                        ToolTip="{loc:Loc Key=Shell.Forward}"/>
            </StackPanel>
        </Grid>

        <!-- File area -->
        <Border Grid.Row="1"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="17"
                Effect="{StaticResource SoftShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="54"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc Key=Explorer.Name}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{loc:Loc Key=Explorer.Type}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Grid.Column="2"
                                   Text="{loc:Loc Key=Explorer.State}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </Grid>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Style="{StaticResource GhostButton}"
                                Command="{Binding RenameCommand}"
                                Visibility="{Binding SelectedEntry, Converter={StaticResource NullToVisibilityConverter}}"
                                Content="{loc:Loc Key=Shell.Rename}"
                                Height="34"
                                MinWidth="78"
                                Margin="0,0,7,0"/>
                        <Button Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteCommand}"
                                Visibility="{Binding SelectedEntry, Converter={StaticResource BooleanModeConverter}, ConverterParameter=Visibility}"
                                Content="{loc:Loc Key=Shell.Delete}"
                                Height="34"
                                MinWidth="68"/>
                    </StackPanel>
                </Grid>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                          MouseDoubleClick="Entry_DoubleClick"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="8,2"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Row"
                                                Padding="10,9"
                                                CornerRadius="11"
                                                Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="48">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Orientation="Horizontal">
                                    <Border Width="40"
                                            Height="40"
                                            CornerRadius="12"
                                            Background="{StaticResource SoftGradientBrush}">
                                        <TextBlock Text="{Binding IsDirectory, Converter={StaticResource EntryIconConverter}}"
                                                   FontSize="17"
                                                   Foreground="{Binding State, Converter={StaticResource EntryStateBrushConverter}}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding FullPath}"
                                                   Margin="0,2,0,0"
                                                   FontSize="8"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="1"
                                           Text="{Binding Kind}"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center"/>

                                <Border Grid.Column="2"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Padding="9,5"
                                        CornerRadius="9"
                                        Background="{StaticResource CyanSoftBrush}">
                                    <TextBlock Text="{Binding StateText}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding State, Converter={StaticResource EntryStateBrushConverter}}"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="390"
                        Padding="26"
                        Background="{StaticResource SurfaceSoftBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{loc:Loc Key=Explorer.EmptyTitle}"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Key=Explorer.EmptySubtitle}"
                                   Margin="0,8,0,0"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddMediaCommand}"
                                Content="{loc:Loc Key=Shell.AddMedia}"
                                MinWidth="118"
                                Height="38"
                                Margin="0,16,0,0"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Pending changes and progress -->
        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Padding="15"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="17"
                Effect="{StaticResource SoftShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Pending.Title}"
                                   FontSize="13"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{loc:Loc Key=Pending.Subtitle}"
                                   Margin="0,3,0,0"
                                   FontSize="9"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontSize="9"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="420"/>
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding SaveChangesCommand}"
                                Content="{Binding SaveButtonText}"
                                Height="38"
                                MinWidth="134"/>
                    </StackPanel>
                </Grid>

                <ProgressBar Grid.Row="1"
                             Height="5"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding OverallProgress}"
                             Foreground="{StaticResource AccentBrush}"/>

                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Margin="0,9,0,4">
                    <ItemsControl ItemsSource="{Binding PendingChanges}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Converter={StaticResource PendingDescriptionConverter}}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"/>
                                        <ProgressBar Height="4"
                                                     Margin="0,6,0,0"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding ProgressPercent}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ErrorMessage}"
                                               Foreground="{StaticResource ErrorBrush}"
                                               FontSize="9"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Margin="10,0"/>
                                    <Button Grid.Column="2"
                                            Style="{StaticResource IconButton}"
                                            Content="×"
                                            Click="CancelPending_Click"
                                            ToolTip="{loc:Loc Key=Shell.Cancel}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="3"
                           Text="{Binding PendingCountText}"
                           FontSize="9"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>