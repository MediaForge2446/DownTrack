<UserControl x:Class="DownTrack.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="174"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Explorer header -->
        <Grid Grid.Row="0"
              Margin="0,0,0,18">
            <StackPanel>
                <TextBlock Text="LIBRARY / EXPLORER"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{StaticResource CyanBrush}"/>
                <TextBlock Text="{Binding RootName}"
                           Margin="0,5,0,0"
                           FontSize="27"
                           FontWeight="SemiBold"/>
            </StackPanel>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    MinWidth="320"
                    MaxWidth="620"
                    Height="40"
                    Padding="13,0"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="11">
                <TextBlock Text="{Binding CurrentPath}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <!-- Navigation + actions -->
        <Grid Grid.Row="1"
              Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding BackCommand}"
                        Content="←"
                        ToolTip="Back"/>
                <Button Style="{StaticResource IconButton}"
                        Command="{Binding ForwardCommand}"
                        Content="→"
                        Margin="4,0,0,0"
                        ToolTip="Forward"/>
                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding HomeCommand}"
                        Content="Home"
                        Margin="8,0,0,0"
                        MinWidth="72"/>

                <Border Width="1"
                        Height="24"
                        Background="{StaticResource BorderBrush}"
                        Margin="14,0"/>

                <Button Style="{StaticResource SecondaryButton}"
                        Command="{Binding NewFolderCommand}"
                        MinWidth="126">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋"
                                   FontSize="14"
                                   Margin="0,0,5,0"/>
                        <TextBlock Text="New folder"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource GhostButton}"
                        Command="{Binding RenameCommand}"
                        Content="Rename"
                        Margin="7,0,0,0"
                        MinWidth="82"/>

                <Button Style="{StaticResource DangerButton}"
                        Command="{Binding DeleteCommand}"
                        Content="Delete"
                        Margin="7,0,0,0"
                        MinWidth="72"/>

                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding AddMediaCommand}"
                        Margin="10,0,0,0"
                        MinWidth="128">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋"
                                   FontSize="15"
                                   Margin="0,0,5,0"/>
                        <TextBlock Text="Add media"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Padding="9,6"
                    CornerRadius="9"
                    Background="{StaticResource SurfaceSoftBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="  Changes are staged safely"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Main explorer area -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"
                                  MinWidth="175"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"
                                  MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- Folder rail -->
            <Border Grid.Column="0"
                    Padding="12"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <StackPanel>
                            <TextBlock Text="FOLDERS"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                            <TextBlock Text="{Binding Folders.Count, StringFormat={}{0} folders}"
                                       Margin="0,4,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource TextBrush}"/>
                        </StackPanel>

                        <Border HorizontalAlignment="Right"
                                Width="32"
                                Height="32"
                                CornerRadius="10"
                                Background="{StaticResource AccentSoftBrush}">
                            <TextBlock Text="▣"
                                       FontSize="15"
                                       Foreground="{StaticResource AccentBlueBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Folders}"
                             Margin="0,13,0,0"
                             MouseDoubleClick="Folder_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,9"
                                        Margin="0,2"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="28"
                                                Height="28"
                                                CornerRadius="8"
                                                Background="{StaticResource SoftGradientBrush}">
                                            <TextBlock Text="▣"
                                                       FontSize="13"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Name}"
                                                   Margin="9,0,5,0"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <TextBlock Grid.Column="2"
                                                   Text="›"
                                                   FontSize="18"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Entry area -->
            <Border Grid.Column="2"
                    Padding="12"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="17">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Margin="10,0,10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="105"/>
                            <ColumnDefinition Width="105"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="NAME"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="TYPE"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                        <TextBlock Grid.Column="2"
                                   Text="STATE"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </Grid>

                    <ListView Grid.Row="1"
                              ItemsSource="{Binding Entries}"
                              SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                              MouseDoubleClick="Entry_DoubleClick"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="105"/>
                                        <ColumnDefinition Width="105"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Width="34"
                                                Height="34"
                                                CornerRadius="9"
                                                Background="{StaticResource SurfaceRaisedBrush}">
                                            <TextBlock Text="{Binding IsDirectory, Converter={StaticResource EntryIconConverter}}"
                                                       FontSize="15"
                                                       Foreground="{Binding State, Converter={StaticResource EntryStateBrushConverter}}"
                                                       HorizontalAlignment="Center"/>
                                        </Border>

                                        <StackPanel Grid.Column="1"
                                                    Margin="10,0,14,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding FullPath}"
                                                       Margin="0,3,0,0"
                                                       FontSize="9"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Kind}"
                                               FontSize="11"
                                               Foreground="{StaticResource MutedTextBrush}"/>

                                    <Border Grid.Column="2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Padding="8,4"
                                            CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource CyanSoftBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding State}" Value="Pending">
                                                        <Setter Property="Background" Value="#FFF5D7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State}" Value="Error">
                                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StateText}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding State, Converter={StaticResource EntryStateBrushConverter}}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Width="360"
                            Padding="24"
                            Background="{StaticResource SurfaceSoftBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="16">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Entries.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="This folder is empty"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Create a folder or add media. New items will appear here immediately as staged changes."
                                       Margin="0,7,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding AddMediaCommand}"
                                    Margin="0,16,0,0"
                                    Content="Add media"
                                    MinWidth="115"
                                    HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Pending queue -->
        <Border Grid.Row="3"
                Margin="0,14,0,0"
                Padding="14"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="17">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28"
                                Height="28"
                                CornerRadius="9"
                                Background="#FFF5D7">
                            <TextBlock Text="•"
                                       FontSize="22"
                                       Foreground="{StaticResource PendingBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="9,0,0,0">
                            <TextBlock Text="Pending changes"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="These changes are still virtual."
                                       Margin="0,2,0,0"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border HorizontalAlignment="Right"
                            Padding="9,5"
                            CornerRadius="9"
                            Background="{StaticResource SurfaceSoftBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding PendingChanges.Count, StringFormat={}{0} queued}"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}"/>
                    </Border>
                </Grid>

                <Grid Grid.Row="1"
                      Margin="0,10,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PendingChanges}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Ellipse Width="8"
                                                 Height="8"
                                                 VerticalAlignment="Center"
                                                 Fill="{Binding Status, Converter={StaticResource PendingStatusBrushConverter}}"/>

                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Description}"
                                                       FontSize="11"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ErrorMessage}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource ErrorBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="Cancel"
                                                Style="{StaticResource GhostButton}"
                                                Padding="10,5"
                                                Click="CancelPending_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="No pending changes"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PendingChanges.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- Commit footer -->
        <Grid Grid.Row="4"
              Margin="2,12,2,0">
            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Ellipse Width="8"
                         Height="8"
                         Fill="{StaticResource SuccessBrush}"/>
                <TextBlock Text="{Binding StatusMessage}"
                           Margin="8,0,0,0"
                           FontSize="11"
                           Foreground="{StaticResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <Button HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveChangesCommand}"
                    Content="{Binding SaveButtonText}"
                    MinWidth="180"/>
        </Grid>
    </Grid>
</UserControl>