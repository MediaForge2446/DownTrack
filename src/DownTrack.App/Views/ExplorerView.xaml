<UserControl x:Class="DownTrack.Views.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:DownTrack.Infrastructure.Windows"
             Background="Transparent">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="175"/>
            <RowDefinition Height="52"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource IconButton}" Command="{Binding BackCommand}" Content="&#xE72B;"/>
                <Button Style="{StaticResource IconButton}" Command="{Binding ForwardCommand}" Content="&#xE72A;" Margin="4,0,0,0"/>
                <Button Style="{StaticResource GhostButton}" Command="{Binding HomeCommand}" Content="Home" Margin="14,0,0,0"/>
            </StackPanel>

            <Border HorizontalAlignment="Right" Width="560" Height="38" Padding="12,0"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="9">
                <TextBlock Text="{Binding CurrentPath}" Foreground="{StaticResource MutedTextBrush}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,6">
            <StackPanel Orientation="Horizontal">
                <Button Style="{StaticResource GhostButton}" Command="{Binding NewFolderCommand}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe Fluent Icons"/><TextBlock Text="  New Folder"/></StackPanel>
                </Button>
                <Button Style="{StaticResource GhostButton}" Command="{Binding RenameCommand}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe Fluent Icons"/><TextBlock Text="  Rename"/></StackPanel>
                </Button>
                <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="8,0,0,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="" FontFamily="Segoe Fluent Icons"/><TextBlock Text="  Delete"/></StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddMediaCommand}" Margin="18,0,0,0">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE1F7;" FontFamily="Segoe Fluent Icons"/><TextBlock Text="  Add Media"/></StackPanel>
                </Button>
            </StackPanel>

            <TextBlock Text="{Binding RootName}" HorizontalAlignment="Right"
                       Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Padding="12" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Folders" Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11" FontWeight="Bold"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Folders}"
                             Margin="0,9,0,0" MouseDoubleClick="Folder_DoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,9" CornerRadius="8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="" FontFamily="Segoe Fluent Icons"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="{Binding Name}" Margin="9,0,0,0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Padding="14" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14">
                <ListView ItemsSource="{Binding Entries}"
                          SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                          MouseDoubleClick="Entry_DoubleClick">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Width="520" Header="Name">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="34" Height="34" CornerRadius="9"
                                                    Background="{StaticResource SurfaceElevatedBrush}">
                                                <TextBlock Text="{Binding IsDirectory, Converter={StaticResource EntryIconConverter}}"
                                                           FontFamily="Segoe Fluent Icons" HorizontalAlignment="Center"
                                                           Foreground="{StaticResource AccentBrush}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Margin="10,0,0,0"
                                                       FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Width="95" Header="Type" DisplayMemberBinding="{Binding Kind}"/>
                            <GridViewColumn Width="95" Header="State" DisplayMemberBinding="{Binding StateText}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>
        </Grid>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="14"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Pending Changes" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="Yellow items exist only in the virtual workspace until you save."
                               HorizontalAlignment="Right" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                </Grid>
                <ScrollViewer Grid.Row="1" Margin="0,10,0,0" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PendingChanges}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="8" Height="8" Fill="{StaticResource PendingBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Description}" FontSize="12"/>
                                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource ErrorBrush}"
                                                   FontSize="10" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="Cancel" Style="{StaticResource GhostButton}"
                                            Padding="10,5" Click="CancelPending_Click"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,9,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"/>
            <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}"
                    Command="{Binding SaveChangesCommand}" Content="Save Changes  →"/>
        </Grid>
    </Grid>
</UserControl>
