<Window x:Class="DownTrack.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:loc="clr-namespace:DownTrack.Infrastructure.Localization"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationService.Instance}}"
        Width="520"
        Height="430"
        MinWidth="520"
        MinHeight="430"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="4"
                            CornerRadius="18"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="26"
            Effect="{StaticResource DialogShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=Settings.Title}"
                               FontSize="25"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc Key=Settings.LanguageDescription}"
                               Margin="0,6,50,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Button Content="×"
                        Style="{StaticResource IconButton}"
                        FontFamily="Segoe UI Symbol"
                        FontSize="18"
                        HorizontalAlignment="Right"
                        Click="Close_Click"
                        ToolTip="{loc:Loc Key=Window.Close}"/>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,22,0,20"
                    Padding="18"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="15">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=Settings.Language}"
                               FontSize="11"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc Key=Settings.Current}"
                               Margin="0,4,0,12"
                               FontSize="10"
                               Foreground="{StaticResource MutedTextBrush}"/>

                    <ComboBox x:Name="LanguageBox"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Code"
                              MinHeight="42"/>
                    
                    <Border Margin="0,14,0,0"
                            Padding="12,9"
                            Background="{StaticResource CyanSoftBrush}"
                            BorderBrush="#B9E4DE"
                            BorderThickness="1"
                            CornerRadius="10">
                        <TextBlock Text="{loc:Loc Key=Settings.RestartNotNeeded}"
                                   FontSize="10"
                                   Foreground="{StaticResource CyanBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{loc:Loc Key=Settings.Done}"
                        Style="{StaticResource GhostButton}"
                        MinWidth="90"
                        Click="Close_Click"/>
                <Button Content="{loc:Loc Key=Settings.Apply}"
                        Style="{StaticResource PrimaryButton}"
                        Margin="8,0,0,0"
                        MinWidth="90"
                        Click="Apply_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>