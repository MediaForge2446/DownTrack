<Window x:Class="DownTrack.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DownTrack.Infrastructure.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationService.Instance}}"
        Width="720"
        Height="720"
        MinWidth="640"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="5"
                            CornerRadius="20"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="26"
            Effect="{StaticResource DialogShadowEffect}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="{loc:Loc Key=Settings.Title}"
                               FontSize="27"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{loc:Loc Key=Settings.Subtitle}"
                               Margin="0,5,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <Button Content="×"
                        Style="{StaticResource IconButton}"
                        HorizontalAlignment="Right"
                        Click="Close_Click"
                        ToolTip="{loc:Loc Key=Window.Close}"/>
            </Grid>

            <ScrollViewer Grid.Row="1"
                          Margin="0,20,0,20"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Appearance -->
                    <Border Padding="18"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="15"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="220"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=Settings.Appearance}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Loc Key=Settings.AppearanceSubtitle}"
                                           Margin="0,4,0,0"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <ComboBox x:Name="ThemeBox"
                                      Grid.Column="1"
                                      MinHeight="42"
                                      Margin="18,0,0,0"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Code"/>
                        </Grid>
                    </Border>

                    <!-- Language -->
                    <Border Padding="18"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="15"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="260"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{loc:Loc Key=Settings.Language}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{loc:Loc Key=Settings.LanguageDescription}"
                                           Margin="0,4,0,0"
                                           FontSize="10"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox x:Name="LanguageBox"
                                      Grid.Column="1"
                                      MinHeight="42"
                                      Margin="18,0,0,0"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Code"/>
                        </Grid>
                    </Border>

                    <!-- Updates -->
                    <Border Padding="18"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="15"
                            Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=Settings.Updates}"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Key=Settings.UpdatesSubtitle}"
                                       Margin="0,4,0,14"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=Settings.AppUpdates}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="AppUpdateStatus"
                                               Margin="0,3,0,0"
                                               FontSize="9"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        x:Name="CheckAppButton"
                                        Style="{StaticResource GhostButton}"
                                        Content="{loc:Loc Key=Settings.Check}"
                                        MinWidth="92"
                                        Margin="8,0"
                                        Click="CheckApp_Click"/>
                                <Button Grid.Column="2"
                                        x:Name="UpdateAppButton"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="{loc:Loc Key=Settings.Update}"
                                        MinWidth="86"
                                        IsEnabled="False"
                                        Click="UpdateApp_Click"/>
                            </Grid>

                            <Border Height="1"
                                    Background="{StaticResource BorderBrush}"
                                    Margin="0,2,0,10"/>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=Settings.ToolUpdates}"
                                               FontSize="11"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="ToolUpdateStatus"
                                               Margin="0,3,0,0"
                                               FontSize="9"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource GhostButton}"
                                        Content="{loc:Loc Key=Settings.Check}"
                                        MinWidth="92"
                                        Margin="8,0"
                                        Click="CheckTools_Click"/>
                                <Button Grid.Column="2"
                                        x:Name="UpdateToolsButton"
                                        Style="{StaticResource PrimaryButton}"
                                        Content="{loc:Loc Key=Settings.Update}"
                                        MinWidth="86"
                                        Click="UpdateTools_Click"/>
                            </Grid>

                            <CheckBox x:Name="AutoUpdateBox"
                                      Content="{loc:Loc Key=Settings.AutoUpdate}"
                                      Margin="0,4,0,6"
                                      FontSize="11"/>
                            <CheckBox x:Name="AutoToolUpdateBox"
                                      Content="{loc:Loc Key=Settings.AutoToolUpdate}"
                                      FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <!-- Defaults -->
                    <Border Padding="18"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="15">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc Key=Settings.Defaults}"
                                       FontSize="13"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{loc:Loc Key=Settings.DefaultsSubtitle}"
                                       Margin="0,4,0,14"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="{loc:Loc Key=Settings.DefaultFormat}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <ComboBox x:Name="FormatBox"
                                              Margin="0,7,0,0"
                                              MinHeight="42"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="{loc:Loc Key=Settings.DefaultAudioQuality}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <ComboBox x:Name="AudioQualityBox"
                                              Margin="0,7,0,0"
                                              MinHeight="42"/>
                                </StackPanel>

                                <StackPanel Grid.Column="4">
                                    <TextBlock Text="{loc:Loc Key=Settings.DefaultVideoQuality}"
                                               FontSize="9"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <ComboBox x:Name="VideoQualityBox"
                                              Margin="0,7,0,0"
                                              MinHeight="42"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Style="{StaticResource GhostButton}"
                        Content="{loc:Loc Key=Settings.Cancel}"
                        MinWidth="92"
                        Click="Close_Click"/>
                <Button Style="{StaticResource PrimaryButton}"
                        Content="{loc:Loc Key=Settings.Save}"
                        MinWidth="110"
                        Margin="8,0,0,0"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>