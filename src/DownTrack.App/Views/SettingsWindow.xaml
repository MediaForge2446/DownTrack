<Window x:Class="DownTrack.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DownTrack.Infrastructure.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Width="620"
        Height="430"
        MinWidth="560"
        MinHeight="390"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="5"
                            CornerRadius="18"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings.Title]}"
                               FontSize="27"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings.Subtitle]}"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <Button Content="×"
                        Style="{StaticResource IconButton}"
                        FontFamily="Segoe UI Symbol"
                        FontSize="19"
                        HorizontalAlignment="Right"
                        Click="Close_Click"/>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,24,0,18"
                    Padding="20"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="15"
                    Effect="{StaticResource SoftShadowEffect}">
                <StackPanel>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings.Language]}"
                               FontSize="15"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings.LanguageHint]}"
                               Margin="0,6,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"/>

                    <ComboBox Margin="0,15,0,0"
                              Height="44"
                              ItemsSource="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=Languages}"
                              SelectedValuePath="Code"
                              SelectedValue="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=SelectedLanguageCode, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding NativeName}"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding EnglishName, StringFormat={}  ·  {0}}"
                                               Margin="10,0,0,0"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Border Margin="0,16,0,0"
                            Padding="12,10"
                            Background="{StaticResource CyanSoftBrush}"
                            BorderBrush="#B9E4DE"
                            BorderThickness="1"
                            CornerRadius="10">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings.Automatic]}"
                                   FontSize="11"
                                   Foreground="{StaticResource CyanBrush}"/>
                    </Border>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings.Version]}"
                           FontSize="10"
                           Foreground="{StaticResource MutedTextBrush}"
                           VerticalAlignment="Center"/>
                <Button Margin="12,0,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[Settings.Save]}"
                        MinWidth="92"
                        Click="Close_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>