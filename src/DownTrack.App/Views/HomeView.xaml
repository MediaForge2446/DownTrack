<UserControl x:Class="DownTrack.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="30,26,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="2,0,2,22">
            <StackPanel>
                <TextBlock Text="Your Library"
                           FontSize="34"
                           FontWeight="SemiBold"/>
                <TextBlock Text="Manage your media folders and build your library safely."
                           Margin="0,6,0,0"
                           FontSize="14"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>

            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddRootFolderCommand}"
                    MinWidth="164">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="" FontFamily="Segoe Fluent Icons"/>
                    <TextBlock Text="  Add root folder"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="1"
                Margin="0,0,0,20"
                Padding="20"
                Background="{StaticResource AccentSoftGradientBrush}"
                BorderBrush="#423A76"
                BorderThickness="1"
                CornerRadius="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="48"
                        Height="48"
                        CornerRadius="14"
                        Background="#2A2B5B">
                    <TextBlock Text=""
                               FontFamily="Segoe Fluent Icons"
                               Foreground="{StaticResource TealBrush}"
                               FontSize="21"
                               HorizontalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="15,0,18,0">
                    <TextBlock Text="STAGED WORKSPACE"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{StaticResource TealBrush}"/>
                    <TextBlock Text="Changes stay virtual until you press Save Changes."
                               Margin="0,5,0,0"
                               FontSize="14"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Add folders, rename files, delete items, and stage media without touching the disk."
                               Margin="0,3,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <Border Grid.Column="2"
                        Padding="12,8"
                        CornerRadius="9"
                        Background="#1A3150"
                        BorderBrush="#31506A"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="SAFE MODE"
                               Foreground="{StaticResource CyanBrush}"
                               FontWeight="SemiBold"
                               FontSize="10"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Roots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Root_Click"
                                Tag="{Binding}"
                                Width="330"
                                Height="156"
                                Margin="0,0,14,14"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="18">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Border Width="44"
                                                        Height="44"
                                                        CornerRadius="12"
                                                        Background="{StaticResource AccentSoftGradientBrush}">
                                                    <TextBlock Text=""
                                                               FontFamily="Segoe Fluent Icons"
                                                               Foreground="{StaticResource AccentBrush}"
                                                               FontSize="21"
                                                               HorizontalAlignment="Center"/>
                                                </Border>

                                                <Border HorizontalAlignment="Right"
                                                        Padding="8,5"
                                                        CornerRadius="8"
                                                        Background="#172B2B">
                                                    <TextBlock Text="READY"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource TealBrush}"/>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="1"
                                                        Margin="0,12,0,6">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="17"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Path}"
                                                           Margin="0,4,0,0"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>

                                            <Grid Grid.Row="2">
                                                <TextBlock Text="Open Explorer"
                                                           FontSize="12"
                                                           Foreground="{StaticResource MutedTextBrush}"/>
                                                <TextBlock Text=""
                                                           FontFamily="Segoe Fluent Icons"
                                                           HorizontalAlignment="Right"
                                                           FontSize="14"
                                                           Foreground="{StaticResource CyanBrush}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="BorderBrush" Value="#5E50A8"/>
                                            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter Property="Background" Value="#20263A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="2,16,2,0">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8"
                         Height="8"
                         Fill="{StaticResource TealBrush}"
                         VerticalAlignment="Center"/>
                <TextBlock Text="{Binding ToolStatus}"
                           Margin="8,0,0,0"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    Style="{StaticResource GhostButton}"
                    Command="{Binding SetupMediaEngineCommand}"
                    Content="{Binding ToolButtonText}"/>
        </Grid>
    </Grid>
</UserControl>