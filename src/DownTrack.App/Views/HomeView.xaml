<UserControl x:Class="DownTrack.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="30,28,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Hero -->
        <Border Grid.Row="0"
                MinHeight="192"
                Margin="0,0,0,20"
                Padding="28"
                Background="{StaticResource SoftGradientBrush}"
                BorderBrush="#3A3B76"
                BorderThickness="1"
                CornerRadius="22">
            <Grid>
                <Ellipse Width="170"
                         Height="170"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Top"
                         Margin="0,-72,-35,0"
                         Fill="{StaticResource AccentBrush}"
                         Opacity="0.08"/>
                <Ellipse Width="120"
                         Height="120"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,110,-62"
                         Fill="{StaticResource CyanBrush}"
                         Opacity="0.07"/>

                <Grid>
                    <StackPanel MaxWidth="760">
                        <Border HorizontalAlignment="Left"
                                Padding="10,6"
                                CornerRadius="9"
                                Background="#221D43"
                                BorderBrush="#4F4086"
                                BorderThickness="1">
                            <TextBlock Text="PERSONAL MEDIA WORKSPACE"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource CyanBrush}"/>
                        </Border>

                        <TextBlock Text="Your library, organized your way."
                                   Margin="0,14,0,0"
                                   FontSize="34"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="Keep folders tidy, stage changes safely, and bring YouTube media exactly where you want it."
                                   Margin="0,8,0,0"
                                   FontSize="14"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextWrapping="Wrap"/>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,18,0,0">
                            <Button Style="{StaticResource PrimaryButton}"
                                    Command="{Binding AddRootFolderCommand}"
                                    MinWidth="164">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="＋"
                                               FontSize="15"
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="Add root folder"/>
                                </StackPanel>
                            </Button>

                            <Border Margin="10,0,0,0"
                                    Padding="12,8"
                                    CornerRadius="10"
                                    Background="#13273A"
                                    BorderBrush="#24556A"
                                    BorderThickness="1">
                                <TextBlock Text="Nothing changes on disk until you save."
                                           FontSize="11"
                                           Foreground="{StaticResource CyanBrush}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,24,0">
                        <TextBlock Text="{Binding Roots.Count}"
                                   FontSize="40"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"/>
                        <TextBlock Text="ROOT FOLDERS"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Quick cards -->
        <Grid Grid.Row="1"
              Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Padding="16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="LIBRARY"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource AccentBlueBrush}"/>
                    <TextBlock Text="Root folders"
                               Margin="0,7,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Roots.Count, StringFormat={}{0} folders connected}"
                               Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Padding="16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="MEDIA ENGINE"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource CyanBrush}"/>
                    <TextBlock Text="{Binding ToolButtonText}"
                               Margin="0,7,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding ToolStatus}"
                               Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4"
                    Padding="16"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel>
                    <TextBlock Text="WORKFLOW"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource PinkBrush}"/>
                    <TextBlock Text="Stage → review → save"
                               Margin="0,7,0,0"
                               FontSize="13"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Your library only changes when you commit."
                               Margin="0,3,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Root folders -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="2,0,2,12">
                <StackPanel>
                    <TextBlock Text="Your folders"
                               FontSize="21"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Open a folder to work inside the DownTrack Explorer."
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>

                <Button HorizontalAlignment="Right"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding AddRootFolderCommand}"
                        MinWidth="145">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="＋"
                                   FontSize="14"
                                   Margin="0,0,5,0"/>
                        <TextBlock Text="Add folder"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Roots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Click="Root_Click"
                                        Tag="{Binding}"
                                        Width="338"
                                        Height="164"
                                        Margin="0,0,14,14"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Surface"
                                                    Background="{StaticResource CardGradientBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="18"
                                                    Padding="18">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>

                                                    <Grid>
                                                        <Border Width="46"
                                                                Height="46"
                                                                CornerRadius="13"
                                                                Background="{StaticResource PrimaryGradientBrush}">
                                                            <TextBlock Text="▣"
                                                                       FontSize="22"
                                                                       Foreground="White"
                                                                       HorizontalAlignment="Center"/>
                                                        </Border>

                                                        <Border HorizontalAlignment="Right"
                                                                Padding="9,5"
                                                                CornerRadius="9"
                                                                Background="#132D2A"
                                                                BorderBrush="#28635B"
                                                                BorderThickness="1">
                                                            <TextBlock Text="CONNECTED"
                                                                       FontSize="9"
                                                                       FontWeight="Bold"
                                                                       Foreground="{StaticResource SuccessBrush}"/>
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel Grid.Row="1"
                                                                Margin="0,14,0,8">
                                                        <TextBlock Text="{Binding Name}"
                                                                   FontSize="17"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Path}"
                                                                   Margin="0,4,0,0"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource MutedTextBrush}"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>

                                                    <Grid Grid.Row="2">
                                                        <TextBlock Text="Open Explorer"
                                                                   FontSize="11"
                                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                                        <TextBlock Text="›"
                                                                   FontSize="22"
                                                                   HorizontalAlignment="Right"
                                                                   Foreground="{StaticResource CyanBrush}"/>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                    <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Surface" Property="Background" Value="{StaticResource SurfaceRaisedBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="430"
                        Padding="28"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Roots.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="62"
                                Height="62"
                                CornerRadius="18"
                                Background="{StaticResource SoftGradientBrush}">
                            <TextBlock Text="＋"
                                       FontSize="30"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource AccentBlueBrush}"/>
                        </Border>
                        <TextBlock Text="Start with your first folder"
                                   Margin="0,16,0,0"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Choose a folder that DownTrack should manage. Everything else starts from there."
                                   Margin="0,7,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddRootFolderCommand}"
                                Margin="0,18,0,0"
                                MinWidth="155"
                                HorizontalAlignment="Center"
                                Content="Choose folder"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Media engine footer -->
        <Border Grid.Row="3"
                Margin="0,18,0,0"
                Padding="13,10"
                Background="{StaticResource SurfaceSoftBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="13">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8"
                             Height="8"
                             Fill="{StaticResource SuccessBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ToolStatus}"
                               Margin="8,0,0,0"
                               FontSize="11"
                               Foreground="{StaticResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <Button HorizontalAlignment="Right"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding SetupMediaEngineCommand}"
                        Content="{Binding ToolButtonText}"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>