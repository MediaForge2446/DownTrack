<UserControl x:Class="DownTrack.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DownTrack.Infrastructure.Localization"
             FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationService.Instance}}"
             Background="Transparent">
    <Grid Margin="38,34,38,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{loc:Loc Key=Library.Overline}"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>
            <TextBlock Text="{loc:Loc Key=Library.Title}"
                       Margin="0,8,0,0"
                       FontSize="32"
                       FontWeight="SemiBold"/>
            <TextBlock Text="{loc:Loc Key=Library.Subtitle}"
                       Margin="0,5,0,0"
                       FontSize="12"
                       Foreground="{StaticResource MutedTextBrush}"/>
        </StackPanel>

        <Grid Grid.Row="1"
              Margin="0,24,0,16">
            <TextBlock Text="{Binding RootSummary}"
                       FontSize="11"
                       Foreground="{StaticResource MutedTextBrush}"/>
            <Button HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddRootFolderCommand}"
                    MinWidth="148"
                    Height="42">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="＋" FontSize="15" Margin="0,0,7,0"/>
                    <TextBlock Text="{loc:Loc Key=Shell.AddFolder}"/>
                </StackPanel>
            </Button>
        </Grid>

        <Border Grid.Row="2"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="17"
                Effect="{StaticResource SoftShadowEffect}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Margin="18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="110"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{loc:Loc Key=Library.Folder}"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Grid.Column="1"
                               Text="{loc:Loc Key=Library.Location}"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Grid.Column="2"
                               Text="{loc:Loc Key=Library.Action}"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="{StaticResource MutedTextBrush}"/>
                </Grid>

                <ListView Grid.Row="1"
                          ItemsSource="{Binding Roots}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="10,3"
                                    Padding="9"
                                    CornerRadius="12"
                                    Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="12"
                                                Background="{StaticResource SoftGradientBrush}">
                                            <TextBlock Text="▣"
                                                       FontSize="17"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Margin="12,0,0,0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Path}"
                                                       Margin="0,3,0,0"
                                                       FontSize="9"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Path}"
                                               FontSize="10"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>

                                    <Button Grid.Column="2"
                                            Style="{StaticResource GhostButton}"
                                            Content="{loc:Loc Key=Library.Open}"
                                            Tag="{Binding}"
                                            Click="Root_Click"
                                            MinWidth="90"
                                            Height="36"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="430"
                        Padding="28"
                        Background="{StaticResource SurfaceSoftBrush}"
                        BorderBrush="{StaticResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Roots.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc Key=Library.EmptyTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Key=Library.EmptySubtitle}"
                                   Margin="0,7,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddRootFolderCommand}"
                                Content="{loc:Loc Key=Shell.AddFolder}"
                                Margin="0,18,0,0"
                                MinWidth="130"
                                HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Margin="0,16,0,0"
                Padding="12,10"
                CornerRadius="12"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <TextBlock Text="{Binding ToolStatus}"
                       FontSize="10"
                       Foreground="{StaticResource MutedTextBrush}"/>
        </Border>
    </Grid>
</UserControl>