<UserControl x:Class="DownTrack.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="34">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="Your Library" FontSize="31" FontWeight="SemiBold"/>
                <TextBlock Text="Choose a root folder to open the DownTrack Explorer."
                           Margin="0,8,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="14"/>
            </StackPanel>

            <Button HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}"
                    Command="{Binding AddRootFolderCommand}"
                    Content="+  Add root folder"/>
        </Grid>

        <Border Grid.Row="1" Margin="0,25,0,14" Padding="16"
                Background="{StaticResource AccentSoftBrush}"
                BorderBrush="#3D2F76" BorderThickness="1" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="STAGED WORKSPACE" Foreground="{StaticResource TealBrush}"
                           FontSize="11" FontWeight="Bold"/>
                <TextBlock Text="Everything you change is prepared here first. Nothing is written to disk until Save Changes."
                           Margin="0,5,0,0" Foreground="{StaticResource TextBrush}" FontSize="13"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Padding="14" Margin="0,0,0,18"
                Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="MEDIA ENGINE" FontSize="11" FontWeight="Bold"
                               Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding ToolStatus}" Margin="0,5,0,0" FontSize="13"/>
                </StackPanel>
                <Button Grid.Column="1" Content="{Binding ToolButtonText}"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding SetupMediaEngineCommand}"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Roots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="Root_Click"
                                Tag="{Binding}"
                                Margin="0,0,14,14"
                                Padding="0"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="1" CornerRadius="14"
                                            Padding="18" Width="285" Height="138">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Width="42" Height="42" CornerRadius="11"
                                                    Background="{StaticResource AccentSoftBrush}">
                                                <TextBlock Text="" FontFamily="Segoe Fluent Icons"
                                                           Foreground="{StaticResource AccentBrush}" FontSize="21"
                                                           HorizontalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="0,12,0,4">
                                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Path}" Margin="0,4,0,0"
                                                           FontSize="11" Foreground="{StaticResource MutedTextBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Text="Open Explorer  ›"
                                                       Foreground="{StaticResource TealBrush}" FontSize="12"
                                                       HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SurfaceHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="#443B67"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="4" Margin="0,18,0,0">
            <TextBlock Text="DownTrack  •  premium media workspace"
                       Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
