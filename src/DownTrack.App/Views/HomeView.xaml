<UserControl x:Class="DownTrack.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DownTrack.Infrastructure.Localization"
             FlowDirection="{Binding FlowDirection, Source={x:Static loc:LocalizationService.Instance}}"
             Background="Transparent">
    <Grid Margin="30,26,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="{loc:Loc Key=Library.Overline}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource AccentBlueBrush}"/>
                <TextBlock Text="{loc:Loc Key=Library.Title}"
                           Margin="0,7,0,0"
                           FontSize="29"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{loc:Loc Key=Library.Subtitle}"
                           Margin="0,5,0,0"
                           FontSize="12"
                           Foreground="{DynamicResource MutedTextBrush}"/>
            </StackPanel>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Padding="12,8"
                    CornerRadius="11"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{DynamicResource SuccessBrush}"
                             VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding RootSummary}"
                               Margin="7,0,0,0"
                               FontSize="10"
                               Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="1"
              Margin="0,20,0,9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="#"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MutedTextBrush}"/>
            <TextBlock Grid.Column="1"
                       Text="{loc:Loc Key=Library.Folder}"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MutedTextBrush}"/>
            <TextBlock Grid.Column="2"
                       Text="{loc:Loc Key=Library.Location}"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MutedTextBrush}"/>
            <TextBlock Grid.Column="3"
                       Text="{loc:Loc Key=Library.Action}"
                       FontSize="10"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MutedTextBrush}"/>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Effect="{DynamicResource SoftShadowEffect}">
            <Grid>
                <ListView x:Name="RootList"
                          ItemsSource="{Binding Roots}"
                          AlternationCount="1000"
                          SelectedItem="{Binding SelectedRoot, Mode=TwoWay}"
                          BorderThickness="0"
                          Background="Transparent"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Row"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="0,0,0,1"
                                                Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,13">
                <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=(ItemsControl.AlternationIndex), StringFormat={}{0}}"
                                           FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Border Width="42"
                                            Height="42"
                                            CornerRadius="12"
                                            Background="{DynamicResource SoftGradientBrush}">
                                        <TextBlock Text="□"
                                                   FontSize="18"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Margin="12,0,0,0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Path}"
                                                   Margin="0,3,0,0"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding Path}"
                                           FontSize="10"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"/>

                                <StackPanel Grid.Column="3"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <Button Style="{StaticResource SecondaryButton}"
                                            Command="{Binding DataContext.OpenRootCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            MinWidth="82"
                                            Height="36">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{loc:Loc Key=Library.Open}"/>
                                            <TextBlock Text="›"
                                                       Margin="7,0,0,0"
                                                       FontSize="17"/>
                                        </StackPanel>
                                    </Button>

                                    <StackPanel Orientation="Horizontal"
                                                Margin="8,0,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <Button Style="{StaticResource GhostButton}"
                                                Command="{Binding DataContext.Home.RenameRootCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Width="70"
                                                Height="36">
                                            <TextBlock Text="{loc:Loc Key=Shell.Rename}"/>
                                        </Button>
                                        <Button Style="{StaticResource DangerButton}"
                                                Command="{Binding DataContext.Home.DeleteRootCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Margin="6,0,0,0"
                                                Width="68"
                                                Height="36">
                                            <TextBlock Text="{loc:Loc Key=Shell.Delete}"/>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid></Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Border Width="420"
                        Padding="26"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SurfaceSoftBrush}"
                        BorderBrush="{DynamicResource BorderStrongBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Roots.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel HorizontalAlignment="Center">
                        <Border Width="58"
                                Height="58"
                                CornerRadius="16"
                                Background="{DynamicResource SoftGradientBrush}">
                            <TextBlock Text="＋"
                                       FontSize="28"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{loc:Loc Key=Library.EmptyTitle}"
                                   Margin="0,15,0,0"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                        <TextBlock Text="{loc:Loc Key=Library.EmptySubtitle}"
                                   Margin="0,7,0,0"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddRootFolderCommand}"
                                Margin="0,16,0,0"
                                MinWidth="140">
                            <TextBlock Text="{loc:Loc Key=Shell.AddFolder}"/>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{loc:Loc Key=Library.EmptySubtitle}"
                   Margin="0,13,0,0"
                   FontSize="10"
                   Foreground="{DynamicResource MutedTextBrush}"/>
    </Grid>
</UserControl>