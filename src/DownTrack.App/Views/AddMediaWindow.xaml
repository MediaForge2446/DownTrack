<Window x:Class="DownTrack.Views.AddMediaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DownTrack.Infrastructure.Localization"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Width="920"
        Height="650"
        MinWidth="600"
        MinHeight="500"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="5"
                            CornerRadius="20"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBrush}"
            Effect="{StaticResource DialogShadowEffect}"
            BorderBrush="{StaticResource BorderStrongBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="6"
                                Height="42"
                                CornerRadius="3"
                                Background="{StaticResource AuroraGradientBrush}"/>
                        <StackPanel Margin="13,0,0,0">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AddMedia.Title]}"
                                       FontSize="28"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AddMedia.Subtitle]}"
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Button Content="×"
                        Style="{StaticResource IconButton}"
                        FontFamily="Segoe UI Symbol"
                        FontSize="19"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="Close_Click"
                        ToolTip="Close"/>
            </Grid>

            <!-- Link input -->
            <Border Grid.Row="1"
                    Effect="{StaticResource SoftShadowEffect}"
                    Margin="0,20,0,13"
                    Padding="9"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="UrlBox"
                             Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="44"
                             FontSize="13"
                             VerticalContentAlignment="Center"
                             ToolTip="YouTube video or playlist URL"/>

                    <Button Grid.Column="1"
                            Margin="9,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding AnalyzeCommand}"
                            MinWidth="112">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AddMedia.Analyze]}"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="→"
                                       FontSize="14"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- Quick actions / status -->
            <Grid Grid.Row="2"
                  Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource SecondaryButton}"
                            Command="{Binding SelectAllCommand}"
                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AddMedia.SelectAll]}"
                            MinWidth="92"/>
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding ApplyMp3Command}"
                            Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AddMedia.Mp3ToAll]}"
                            Margin="8,0,0,0"
                            MinWidth="96"/>
                </StackPanel>

                <Border HorizontalAlignment="Right"
                        Padding="10,6"
                        CornerRadius="10"
                        Background="{StaticResource SurfaceSoftBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="{StaticResource SuccessBrush}"
                                 VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsResolving}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding Status}"
                                   Margin="7,0,0,0"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="470"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Results -->
            <Border Grid.Row="3"
                    Effect="{StaticResource SoftShadowEffect}"
                    Padding="10"
                    Background="{StaticResource SurfaceSoftBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="13"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <!-- Media identity -->
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="78"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox IsChecked="{Binding Selected}"
                                                          Margin="1,0,12,0"/>

                                                <Border Grid.Column="1"
                                                        Width="66"
                                                        Height="66"
                                                        CornerRadius="11"
                                                        Background="{StaticResource SurfaceRaisedBrush}"
                                                        ClipToBounds="True">
                                                    <Image Source="{Binding ThumbnailUrl}"
                                                           Stretch="UniformToFill"/>
                                                </Border>

                                                <StackPanel Grid.Column="2"
                                                            Margin="13,0,14,0"
                                                            VerticalAlignment="Center">
                                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             Padding="0"
                                                             FontSize="14"
                                                             FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding SourceUrl}"
                                                               Margin="0,5,0,0"
                                                               FontSize="9"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <Border Grid.Column="3"
                                                        VerticalAlignment="Center"
                                                        Padding="10,6"
                                                        CornerRadius="9"
                                                        Background="{StaticResource AccentSoftBrush}">
                                                    <TextBlock Text="{Binding IsVideo, Converter={StaticResource BooleanModeConverter}}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource AccentBlueBrush}"/>
                                                </Border>
                                            </Grid>

                                            <!-- Per-item controls -->
                                            <Grid Grid.Row="1"
                                                  Margin="91,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Margin="0,0,7,0">
                                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AddMedia.Format]}"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource MutedTextBrush}"/>
                                                    <ComboBox ItemsSource="{Binding Formats}"
                                                              SelectedItem="{Binding Format}"
                                                              Margin="0,4,0,0">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={StaticResource MediaOptionLabelConverter}}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Margin="4,0,4,0">
                                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AddMedia.AudioQuality]}"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource MutedTextBrush}"/>
                                                    <ComboBox ItemsSource="{Binding AudioQualities}"
                                                              SelectedItem="{Binding AudioQuality}"
                                                              Margin="0,4,0,0">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={StaticResource MediaOptionLabelConverter}}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            Margin="7,0,0,0">
                                                    <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AddMedia.VideoQuality]}"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource MutedTextBrush}"/>
                                                    <ComboBox ItemsSource="{Binding VideoQualities}"
                                                              SelectedItem="{Binding VideoQuality}"
                                                              IsEnabled="{Binding IsVideo}"
                                                              Margin="0,4,0,0">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={StaticResource MediaOptionLabelConverter}}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Empty -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Border Width="62"
                                Height="62"
                                CornerRadius="18"
                                Background="{StaticResource SoftGradientBrush}"
                                HorizontalAlignment="Center">
                            <TextBlock Text="＋"
                                       FontSize="30"
                                       Foreground="{StaticResource AccentBlueBrush}"
                                       HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AddMedia.NoMedia]}"
                                   Margin="0,13,0,0"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AddMedia.NoMediaHint]}"
                                   Margin="0,5,0,0"
                                   FontSize="10"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- Analyze loading -->
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="20,15"
                            Background="{StaticResource SurfaceRaisedBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="13">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsResolving}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Width="190">
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AddMedia.Preparing]}"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AddMedia.PreparingHint]}"
                                       Margin="0,5,0,0"
                                       FontSize="10"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"/>
                            <ProgressBar Margin="0,11,0,0"
                                         Height="5"
                                         IsIndeterminate="True"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Footer -->
            <Border Grid.Row="4"
                    Effect="{StaticResource SoftShadowEffect}"
                    Margin="0,13,0,0"
                    Padding="13"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <Grid>
                    <StackPanel MaxWidth="510">
                        <TextBlock Text="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AddMedia.Destination]}"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource CyanBrush}"/>
                        <TextBlock Text="{Binding CurrentFolder}"
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AddMedia.Cancel]}"
                                Style="{StaticResource GhostButton}"
                                Click="Close_Click"
                                MinWidth="78"/>
                        <Button Content="{Binding Source={x:Static loc:LocalizationManager.Instance}, Path=[AddMedia.StageSelected]}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0"
                                MinWidth="132"
                                Click="Add_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>