<Window x:Class="DownTrack.Views.AddMediaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Width="900"
        Height="620"
        MinWidth="520"
        MinHeight="460"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="0"
                            CornerRadius="18"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="6"
                                Height="38"
                                CornerRadius="3"
                                Background="{StaticResource AccentGradientBrush}"/>
                        <StackPanel Margin="12,0,0,0">
                            <TextBlock Text="Add Media"
                                       FontSize="27"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Paste a YouTube link, choose the output for each item, and stage it for this folder."
                                       Margin="0,4,0,0"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Button Content="&#xE8BB;"
                        Style="{StaticResource IconButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Click="Close_Click"
                        ToolTip="Close"/>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,20,0,12"
                    Padding="10"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="UrlBox"
                             Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                             MinHeight="42"
                             Padding="12,9"
                             VerticalContentAlignment="Center"
                             FontSize="13"/>

                    <Button Grid.Column="1"
                            Margin="9,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding AnalyzeCommand}"
                            MinWidth="108"
                            Content="Analyze"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2"
                  Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding SelectAllCommand}"
                            Content="Select all"
                            MinWidth="92"/>
                    <Button Style="{StaticResource GhostButton}"
                            Command="{Binding ApplyMp3Command}"
                            Content="MP3 to all"
                            Margin="8,0,0,0"
                            MinWidth="92"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Ellipse Width="7"
                             Height="7"
                             Fill="{StaticResource TealBrush}"
                             VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <DataTrigger Binding="{Binding IsResolving}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Status}"
                               Margin="7,0,0,0"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="470"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="3"
                    Padding="10"
                    Background="#0C0F17"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="15">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,9"
                                            Padding="12"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="13">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="78"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <CheckBox IsChecked="{Binding Selected}"
                                                          Margin="0,0,12,0"
                                                          VerticalAlignment="Center"/>

                                                <Border Grid.Column="1"
                                                        Width="66"
                                                        Height="66"
                                                        CornerRadius="10"
                                                        Background="{StaticResource SurfaceElevatedBrush}"
                                                        ClipToBounds="True">
                                                    <Image Source="{Binding ThumbnailUrl}"
                                                           Stretch="UniformToFill"/>
                                                </Border>

                                                <StackPanel Grid.Column="2"
                                                            Margin="12,0,12,0">
                                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             Padding="0"
                                                             FontSize="14"
                                                             FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding SourceUrl}"
                                                               Margin="0,4,0,0"
                                                               FontSize="10"
                                                               Foreground="{StaticResource MutedTextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <Border Grid.Column="3"
                                                        Margin="4,0,0,0"
                                                        Padding="9,6"
                                                        CornerRadius="8"
                                                        Background="{StaticResource AccentSoftBrush}">
                                                    <TextBlock Text="{Binding IsVideo, Converter={StaticResource BooleanModeConverter}}"
                                                               Foreground="{StaticResource CyanBrush}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"/>
                                                </Border>
                                            </Grid>

                                            <Grid Grid.Row="1"
                                                  Margin="90,11,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Margin="0,0,7,0">
                                                    <TextBlock Text="FORMAT"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource MutedTextBrush}"/>
                                                    <ComboBox ItemsSource="{Binding Formats}"
                                                              SelectedItem="{Binding Format}"
                                                              Margin="0,4,0,0}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={StaticResource MediaOptionLabelConverter}}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1"
                                                            Margin="4,0,4,0">
                                                    <TextBlock Text="AUDIO"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource MutedTextBrush}"/>
                                                    <ComboBox ItemsSource="{Binding AudioQualities}"
                                                              SelectedItem="{Binding AudioQuality}"
                                                              Margin="0,4,0,0}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={StaticResource MediaOptionLabelConverter}}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>

                                                <StackPanel Grid.Column="2"
                                                            Margin="7,0,0,0">
                                                    <TextBlock Text="VIDEO"
                                                               FontSize="9"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource MutedTextBrush}"/>
                                                    <ComboBox ItemsSource="{Binding VideoQualities}"
                                                              SelectedItem="{Binding VideoQuality}"
                                                              IsEnabled="{Binding IsVideo}"
                                                              Margin="0,4,0,0}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Converter={StaticResource MediaOptionLabelConverter}}"/>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text=""
                                   FontFamily="Segoe Fluent Icons"
                                   FontSize="34"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="No media loaded"
                                   Margin="0,10,0,0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Paste a YouTube link above and select Analyze."
                                   Margin="0,4,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>

                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="18,14"
                            Background="{StaticResource SurfaceElevatedBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <DataTrigger Binding="{Binding IsResolving}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="Analyzing link…"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"/>
                            <ProgressBar Width="180"
                                         Height="4"
                                         Margin="0,9,0,0"
                                         IsIndeterminate="True"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="4"
                    Margin="0,13,0,0"
                    Padding="13"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="13">
                <Grid>
                    <StackPanel MaxWidth="500">
                        <TextBlock Text="DESTINATION"
                                   FontSize="9"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TealBrush}"/>
                        <TextBlock Text="{Binding CurrentFolder}"
                                   Margin="0,3,0,0"
                                   FontSize="12"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button Content="Cancel"
                                Style="{StaticResource GhostButton}"
                                Click="Close_Click"
                                MinWidth="78"/>
                        <Button Content="Stage selected"
                                Style="{StaticResource PrimaryButton}"
                                Margin="8,0,0,0"
                                MinWidth="130"
                                Click="Add_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>