<Window x:Class="DownTrack.Views.AddMediaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DownTrack.Views"
        WindowStartupLocation="CenterOwner"
        Width="1120" Height="730"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Border Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="20">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel>
                    <TextBlock Text="Add Media" FontSize="28" FontWeight="SemiBold"/>
                    <TextBlock Text="Analyze a YouTube video or playlist, customize each item, then stage it."
                               Margin="0,7,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <Button Content="&#xE8BB;" FontFamily="Segoe Fluent Icons" Style="{StaticResource IconButton}"
                        HorizontalAlignment="Right" Click="Close_Click"/>
            </Grid>

            <Border Grid.Row="1" Margin="0,22,0,12" Padding="14"
                    Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="13">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" MinHeight="42"
                             VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="Analyze" Style="{StaticResource PrimaryButton}"
                            Command="{Binding AnalyzeCommand}" Margin="10,0,0,0"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="35"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="80"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="Title / filename" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                <TextBlock Grid.Column="2" Text="Format" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                <TextBlock Grid.Column="3" Text="Audio" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                <TextBlock Grid.Column="4" Text="Video" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                <TextBlock Grid.Column="5" Text="Mode" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
            </Grid>

            <ScrollViewer Grid.Row="3">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                    CornerRadius="13" Padding="12" Margin="0,0,0,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="35"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="125"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Selected}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Margin="6,0,14,0">
                                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                 BorderThickness="0" Background="Transparent"
                                                 Padding="0" FontSize="14"/>
                                        <TextBlock Text="{Binding SourceUrl}" Margin="0,4,0,0"
                                                   Foreground="{StaticResource MutedTextBrush}" FontSize="10"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="2"
                                              ItemsSource="{Binding Source={x:Static local:MediaOptions.Formats}}"
                                              SelectedItem="{Binding Format}" Margin="0,0,10,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource MediaOptionLabelConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="3"
                                              ItemsSource="{Binding Source={x:Static local:MediaOptions.AudioQualities}}"
                                              SelectedItem="{Binding AudioQuality}" Margin="0,0,10,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource MediaOptionLabelConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <ComboBox Grid.Column="4"
                                              ItemsSource="{Binding Source={x:Static local:MediaOptions.VideoQualities}}"
                                              SelectedItem="{Binding VideoQuality}" Margin="0,0,10,0">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Converter={StaticResource MediaOptionLabelConverter}}"/>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Grid.Column="5" Text="{Binding IsVideo, Converter={StaticResource BooleanModeConverter}}"
                                               Foreground="{StaticResource MutedTextBrush}" HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Grid Grid.Row="4" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Destination" FontSize="11" Foreground="{StaticResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding CurrentFolder}" Margin="0,4,0,0" FontSize="12"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Status}" Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource GhostButton}" Click="Close_Click"/>
                    <Button Content="Add to pending changes  →" Style="{StaticResource PrimaryButton}"
                            Margin="9,0,0,0" Click="Add_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
