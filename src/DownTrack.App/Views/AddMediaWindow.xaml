<Window x:Class="DownTrack.Views.AddMediaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStartupLocation="CenterOwner"
        Width="1120" Height="730"
        MinWidth="760" MinHeight="540"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            CornerRadius="18" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{StaticResource WindowBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18">
        <Viewbox Stretch="Uniform"
                 StretchDirection="Both"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center">
            <Grid Width="1068" Height="678" Margin="26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="8" Height="34" CornerRadius="4"
                                    Background="{StaticResource TealBrush}"/>
                            <StackPanel Margin="12,0,0,0">
                                <TextBlock Text="Add Media" FontSize="29" FontWeight="SemiBold"/>
                                <TextBlock Text="Bring one video or an entire playlist into the current folder."
                                           Margin="0,5,0,0"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="13"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <Button Content="&#xE8BB;"
                            FontFamily="Segoe Fluent Icons"
                            Style="{StaticResource IconButton}"
                            HorizontalAlignment="Right"
                            ToolTip="Close"
                            Click="Close_Click"/>
                </Grid>

                <Border Grid.Row="1" Margin="0,22,0,14" Padding="13"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="44"
                                 VerticalContentAlignment="Center"
                                 ToolTip="YouTube video or playlist URL"/>
                        <Button Grid.Column="1"
                                Content="Analyze"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding AnalyzeCommand}"
                                Margin="10,0,0,0"
                                MinWidth="112"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Margin="0,0,0,8"
                        Background="{StaticResource AccentSoftGradientBrush}"
                        BorderBrush="#3A3266"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="10,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="124"/>
                            <ColumnDefinition Width="112"/>
                            <ColumnDefinition Width="118"/>
                            <ColumnDefinition Width="82"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0"
                                  VerticalAlignment="Center"
                                  IsEnabled="False"/>
                        <TextBlock Grid.Column="2" Text="Title / filename"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                        <TextBlock Grid.Column="3" Text="Format"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                        <TextBlock Grid.Column="4" Text="Audio"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                        <TextBlock Grid.Column="5" Text="Video"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                        <TextBlock Grid.Column="6" Text="Mode"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="11"/>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="13"
                                        Padding="10"
                                        Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34"/>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="124"/>
                                            <ColumnDefinition Width="112"/>
                                            <ColumnDefinition Width="118"/>
                                            <ColumnDefinition Width="82"/>
                                        </Grid.ColumnDefinitions>

                                        <CheckBox IsChecked="{Binding Selected}"
                                                  VerticalAlignment="Center"/>

                                        <Border Grid.Column="1"
                                                Width="50" Height="50"
                                                CornerRadius="9"
                                                Background="{StaticResource SurfaceElevatedBrush}"
                                                ClipToBounds="True"
                                                VerticalAlignment="Center">
                                            <Image Source="{Binding ThumbnailUrl}"
                                                   Stretch="UniformToFill"/>
                                        </Border>

                                        <StackPanel Grid.Column="2"
                                                    Margin="11,0,14,0">
                                            <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     Padding="0"
                                                     FontSize="14"/>
                                            <TextBlock Text="{Binding SourceUrl}"
                                                       Margin="0,4,0,0"
                                                       Foreground="{StaticResource MutedTextBrush}"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <ComboBox Grid.Column="3"
                                                  ItemsSource="{Binding Source={x:Static local:MediaOptions.Formats}}"
                                                  SelectedItem="{Binding Format}"
                                                  Margin="0,0,8,0">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource MediaOptionLabelConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <ComboBox Grid.Column="4"
                                                  ItemsSource="{Binding Source={x:Static local:MediaOptions.AudioQualities}}"
                                                  SelectedItem="{Binding AudioQuality}"
                                                  Margin="0,0,8,0}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource MediaOptionLabelConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <ComboBox Grid.Column="5"
                                                  ItemsSource="{Binding Source={x:Static local:MediaOptions.VideoQualities}}"
                                                  SelectedItem="{Binding VideoQuality}"
                                                  Margin="0,0,8,0}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource MediaOptionLabelConverter}}"/>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>

                                        <TextBlock Grid.Column="6"
                                                   Text="{Binding IsVideo, Converter={StaticResource BooleanModeConverter}}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="4"
                        Margin="0,16,0,0"
                        Padding="14,11"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="13">
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="DESTINATION"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TealBrush}"/>
                            <TextBlock Text="{Binding CurrentFolder}"
                                       Margin="0,3,0,0"
                                       FontSize="12"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Status}"
                                       Margin="0,4,0,0"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button Content="Cancel"
                                    Style="{StaticResource GhostButton}"
                                    Click="Close_Click"/>
                            <Button Content="Add to pending changes  →"
                                    Style="{StaticResource PrimaryButton}"
                                    Margin="9,0,0,0"
                                    MinWidth="205"
                                    Click="Add_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Viewbox>
    </Border>
</Window>